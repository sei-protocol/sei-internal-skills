# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom
#
# sei-omnigent runner overlay — layers this repo's two runner inputs onto the
# omnigent host image: the `.claude/` agent roster and skills, and the Spec Kit CLI.
#
# Managed runners resolve their host-scope skills and their `.claude/agents/`
# specialist roster from $HOME. The provider mounts an emptyDir at `_HOME_DIR`
# (/home/omnigent), which IS $HOME, so an overlay staged at that path is shadowed
# by the mount and never visible. The overlay is therefore staged outside $HOME and
# seeded into it by a profile.d hook, which is the only available seed point: the
# provider sets the Pod command explicitly (`bash -lc`), so there is no ENTRYPOINT
# to hook, and a login shell sources profile.d.
#
# `/xreview` and `/root-cause` halt without a roster, and an agent that resolves
# `skills: all` against an empty host scope runs with no skills. See PLT-872.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# No USER at the end, matching the base image, which ends as root and relies on the
# provider's runAsUser. A USER here would only change `docker run` semantics and
# could surprise the sandbox launchers that supply their own command.
USER root

# Spec Kit CLI, in its own venv so its dependency closure cannot perturb omnigent's.
# Pinned to the release the sei-spec bundle vendors its skill bodies from, so the
# tool and the method cannot drift apart. `--only-binary` keeps a source
# distribution's setup.py from executing during the build.
#
# The base image sha256-verifies each third-party CLI it installs and its authors
# note that a version check alone is not a supply-chain control. That bar is not met
# here: the exact version is immutable on PyPI, but the transitive closure resolves
# fresh on every build. Closing it needs a hash-pinned requirements file, tracked
# separately. The `--version` assertion below only fails the build if the pin stops
# resolving; it is not integrity verification.
ARG SPECIFY_VERSION=0.15.0
RUN python3 -m venv /opt/specify \
 && /opt/specify/bin/pip install --no-cache-dir --disable-pip-version-check \
      --only-binary=:all: "specify-cli==${SPECIFY_VERSION}" \
 && ln -s /opt/specify/bin/specify /usr/local/bin/specify \
 && specify --version 2>&1 | grep -q "${SPECIFY_VERSION}"

# Vale and the writing contract's rules, so the gate runs inside the sandbox rather
# than only in a consumer's CI after a push. `sei-spec` writes specification prose and
# its prompt now instructs it to lint each artifact; without this that instruction is
# a hint with nothing behind it.
#
# THE VERSION IS A FLOOR SHARED WITH .github/workflows/writing.yml. On 3.14.0 a
# `sequence` whose tokens are all `tag:` entries matches nothing, which disables a rule
# in silence. Keep the two in step: a runner checking a different rule set than CI is
# the disagreement this pin exists to stop.
#
# Unlike the Spec Kit pin above, this one IS integrity-verified: the checksum covers
# the exact release asset, so a substituted tarball fails the build. The asset is
# amd64, matching the fleet. On another architecture the extract succeeds and
# `vale --version` fails to exec, so the build stops rather than shipping a broken
# binary.
ARG VALE_VERSION=3.17.1
ARG VALE_SHA256=db947f89f2292e6a0381a61de155f6a5f5cb4cb460ca178ea412ef605559cefd
RUN curl -sfL --retry 3 --retry-all-errors --max-time 180 -o /tmp/vale.tgz \
      "https://github.com/vale-cli/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
 && echo "${VALE_SHA256}  /tmp/vale.tgz" | sha256sum -c - \
 && tar -xz -C /usr/local/bin -f /tmp/vale.tgz vale \
 && rm /tmp/vale.tgz \
 && vale --version

# The rules, and a configuration that resolves them from any working directory.
#
# StylesPath is rewritten to an absolute path because the committed template names
# `.vale/styles`, which is relative to wherever Vale runs. A sandbox lints a clone at
# an arbitrary path, so a relative styles path would resolve to a directory that does
# not exist and Vale would stop on a configuration error.
#
# `vale sync` runs HERE, at build time, and that is what makes the gate work offline.
# The configuration declares third-party packages that are not committed anywhere; a
# runner that had to fetch them would depend on egress through the sandbox policy
# proxy, and would fail closed on a green-looking `vale` that never loaded its styles.
#
# `a+rX` for the same reason as the overlay below: root-owned tree, non-root runtime
# uid, so the files need other-read and the directories other-traverse.
COPY writing/styles /opt/sei/writing/styles
COPY writing/templates/consumer.vale.ini /opt/sei/writing/vale.ini
COPY scripts/sei-writing-lint /usr/local/bin/sei-writing-lint
#
# The grep is the assertion, not decoration. `sed -i` exits 0 when it matches nothing,
# so a template that renames or reformats that key would leave the relative path in
# place and the build would carry on. Vale then resolves the styles against the
# agent's working directory and reports no findings, which is the green-over-nothing
# failure this whole layer exists to remove.
RUN sed -i 's|^StylesPath = .*|StylesPath = /opt/sei/writing/styles|' /opt/sei/writing/vale.ini \
 && grep -qx 'StylesPath = /opt/sei/writing/styles' /opt/sei/writing/vale.ini \
 && vale --config=/opt/sei/writing/vale.ini sync \
 && chmod 0755 /usr/local/bin/sei-writing-lint \
 && chmod -R a+rX /opt/sei/writing \
 && vale --no-global --config=/opt/sei/writing/vale.ini ls-config > /dev/null

# The overlay, staged outside $HOME per the note above. Scoped to `agents/` and
# `skills/` by Dockerfile.runner.dockerignore; `settings.json` is deliberately not
# shipped, see that file.
#
# `a+rX` is load-bearing rather than cosmetic: the staged tree is root-owned and the
# runtime uid is not the owner, so it needs other-read on files and other-traverse on
# directories for the seeding copy to read it. The conditional-execute form of `X` is
# why this is a separate RUN rather than a COPY --chmod octal, which would either
# mark every skill executable or make directories untraversable.
COPY .claude /opt/sei/claude-overlay
RUN chmod -R a+rX /opt/sei/claude-overlay

# Claude Code's admin policy, read from this path ahead of user settings and not
# overridable by `--settings`.
#
# It is not part of the overlay above, and that is the point: the overlay is seeded
# into $HOME, which is an agent-writable emptyDir, so a permission file placed there
# is one its own subject can rewrite. /etc is outside every mount and owned by root,
# so this lands on every runner and the runtime uid cannot edit it.
#
# Every listed tool runs without raising a permission request. A request from a
# sandbox reaches no human: omnigent's PermissionRequest hook long-polls for a day
# holding a half-hour credential, so one unanswered request wedges the session for
# the rest of its life. Anything unlisted still asks, and still carries that risk —
# the list is deliberately wide enough to cover what a review does rather than
# minimal. scripts/agent-permissions.json holds the narrower per-command patterns
# this should converge on.
COPY scripts/managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod 0444 /etc/claude-code/managed-settings.json

# Seed $HOME/.claude from the staged overlay at login-shell start.
#
# Four properties this has to hold, each asserted in verify-runner-image.yml:
#
#   Fail-visible, not fail-latched. The marker is written ONLY when the copy
#   succeeded. Writing it unconditionally would let a copy that died partway
#   (ephemeral-storage exhaustion, interrupt) seal a half-roster for the Pod's life,
#   silently — the same invisible degradation this overlay exists to remove. `cp -n`
#   exits 0 when every file is skipped, so coupling them stays idempotent.
#
#   Idempotent and cheap. This runs per `bash -lc`, not once per Pod, so the marker
#   short-circuits every invocation after the first.
#
#   Non-destructive. claude-code creates its own state (sessions/, plugins/, cache/)
#   in this directory, so the copy is no-clobber and never removes.
#
#   Never fatal. Pods are restartPolicy: Never, so a login shell exiting non-zero
#   wedges the launch outright. Every path returns 0. The marker write is wrapped
#   because a failed redirection prints before `||` can apply, which would emit a
#   diagnostic on every command in the session.
#
# The lock covers the case where the init container's seed did not complete: the
# provider runs `workspace-prep` with `bash -lc` against the same home volume, so
# normally the seed lands there, once, before the host container starts. If it did
# not, concurrent commands in the host container would otherwise race `cp` per-file.
# `yy-` sorts after the venv and gh-token snippets and before zz-sei-cred-check.
RUN printf '%s\n' \
      '# Seed the staged .claude overlay into the emptyDir HOME (see Dockerfile.runner).' \
      'if [ -d /opt/sei/claude-overlay ] && [ -n "${HOME:-}" ] \' \
      '   && [ ! -e "$HOME/.claude/.sei-overlay" ]; then' \
      '  if mkdir -p "$HOME/.claude" 2>/dev/null; then' \
      '    flock "$HOME/.claude" sh -c '"'"'cp -Rn /opt/sei/claude-overlay/. "$HOME/.claude/"'"'"' 2>/dev/null \' \
      '      && { : > "$HOME/.claude/.sei-overlay"; } 2>/dev/null || true' \
      '  fi' \
      'fi' \
      > /etc/profile.d/yy-sei-claude-overlay.sh \
 && chmod 0755 /etc/profile.d/yy-sei-claude-overlay.sh \
 && sh -n /etc/profile.d/yy-sei-claude-overlay.sh
