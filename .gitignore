# Runtime output of retired skills. Kept so a leftover in an older checkout stays out of a commit.
.council/archive/
.bugbash/archive/
experimental/skills/*/state/**
!experimental/skills/*/state/
!experimental/skills/*/state/.gitkeep

# A skill's runtime output. Git tracks only state/.gitkeep, so state/ exists in a fresh clone.
.claude/skills/*/state/**
!.claude/skills/*/state/
!.claude/skills/*/state/.gitkeep

# python bytecode
__pycache__/
*.pyc

# sei-agent-driver build output
sei-agent-driver/bin/

# goreleaser output
sei-agent-driver/dist/

# Vale fetches write-good into the styles path. The rules under
# writing/styles/AgenticWriting are ours and are committed.
writing/styles/write-good/
