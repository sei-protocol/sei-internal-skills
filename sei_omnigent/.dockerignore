# Ignore everything by default, then re-include only what the image build needs.
# Mirrors the sei-k8s-controller deny-all-then-re-include pattern. Context is
# sei_omnigent/.
**

# Build inputs: the package manifest + the src/ tree (the package, incl. the
# policies/ package dir which lives under src/sei_omnigent/policies — no separate
# top-level policies/ data dir exists in this layout).
!pyproject.toml
!src/**

# The baked agent bundles (config + skill body) — registered by the server via
# OMNIGENT_BUILTIN_AGENT_DIRS. xreview (the review venue, Design-18) and
# root-cause (the Design-20 operation kit; its Grafana-MCP signal source is a
# runtime sidecar, so nothing extra is baked). Their skills/ trees are included;
# caches are pruned below.
!agents/xreview/**
!agents/root-cause/**

# Keep tests, caches, build artifacts, and editable-install metadata OUT — none
# are needed to `pip install .`, and shipping them only bloats the context/image.
src/**/__pycache__
src/*.egg-info
agents/xreview/**/__pycache__
agents/root-cause/**/__pycache__
