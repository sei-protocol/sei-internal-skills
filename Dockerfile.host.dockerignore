# Build context for Dockerfile.host is the REPO ROOT (the `.claude/` overlay
# lives there, outside sei_omnigent/). Deny-all then re-include only what the
# host image needs — mirrors sei_omnigent/.dockerignore's pattern so the context
# stays small and a stray monorepo file can't leak into the image.
#
# BuildKit honors a `<dockerfile>.dockerignore` sibling in preference to a root
# `.dockerignore`, so this scopes the deny-list to the host build alone and
# leaves any future root-context build unaffected.
**

# The package manifest + src tree (resolved into the venv by the builder stage).
!sei_omnigent/pyproject.toml
!sei_omnigent/src/**

# The Tide overlay (skills + agents) baked at $HOME/.claude in the host stage.
!.claude/**

# Keep caches / editable-install metadata OUT — not needed to `pip install .`,
# and shipping them only bloats the context/image.
sei_omnigent/src/**/__pycache__
sei_omnigent/src/*.egg-info
.claude/**/__pycache__
